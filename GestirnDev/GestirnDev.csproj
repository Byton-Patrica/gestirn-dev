<Project Sdk="Microsoft.NET.Sdk">
  <!-- Gestirn dev targets .NET Framework 4.8 (part of Windows), so the app is a single small exe.
       build.ps1 compiles the same sources with the Roslyn csc from Visual Studio Build Tools. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>GestirnEra-70s.ico</ApplicationIcon>
    <AssemblyName>Gestirn-dev</AssemblyName>
    <RootNamespace>GestirnDev</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.Security" />
    <Content Include="GestirnEra-70s.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Assets\Branding\GestirnEra-70s-256.png" Link="GestirnEra-70s-256.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
